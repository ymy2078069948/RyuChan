---
import type { Post, Page } from "@interfaces/data";
import PostCard from "@components/PostCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import Pagination from "@components/widgets/Pagination.astro";
import { Icon } from "astro-icon/components";
import {
  USER_AVATAR,
  USER_NAME,
  USER_DESCRIPTION,
  USER_SIDEBAR_SOCIAL_ICONS,
} from "@config";
import { generatePageLinks } from "@utils/blogUtils";
import { getMainBlogPaginationPaths } from "@utils/paginationUtils";

export async function getStaticPaths({ paginate }: { paginate: any }) {
  return getMainBlogPaginationPaths({ paginate });
}

const { page }: { page: Page } = Astro.props;
const totalPages = Math.ceil(page.total / page.size);
const pageLinks = generatePageLinks(totalPages);
---

<BaseLayout title="Blog" isIndexed={false}>
  <!-- Mobile Profile Bar — only visible on small/medium screens -->
  <div class="rounded-3xl bg-base-100 shadow-lg border border-base-200 transition-all lg:hidden mb-4">
    <div class="flex flex-row md:flex-col md:pt-4">
      <a href="/about" class="relative h-36 w-36 shrink-0 md:hidden">
        <img
          class="absolute left-0 top-0 h-36 rounded-l-3xl object-cover"
          data-runtime-image="user.avatar" src={USER_AVATAR}
          alt="Avatar"
          loading="eager"
        />
        <div class="absolute right-0 top-0 h-36 w-20 bg-gradient-to-l from-base-100"></div>
      </a>
      <a href="/about" class="mx-auto hidden h-36 w-36 cursor-pointer rounded-3xl transition-all hover:brightness-75 md:block">
        <img
          class="h-36 w-36 rounded-3xl object-cover"
          data-runtime-image="user.avatar" src={USER_AVATAR}
          alt="Avatar"
          loading="lazy"
        />
      </a>
      <div class="flex grow flex-col justify-center space-y-3 p-4">
        <div class="flex flex-col items-center">
          <a href="/about" class="line-clamp-1 text-xl font-semibold text-base-content">
            <span data-runtime-text="user.name">{USER_NAME}</span>
          </a>
          <span class="mb-2 mt-1 h-1 w-8 rounded-full bg-primary"></span>
          <p class="line-clamp-1 text-base-content/60 text-sm font-semibold"><span data-runtime-text="user.description">{USER_DESCRIPTION}</span></p>
        </div>
        <ul class="flex flex-row items-center justify-center space-x-5">
          {USER_SIDEBAR_SOCIAL_ICONS.map((icon) => (
            <li>
              <a href={icon.href} target="_blank" aria-label={icon.ariaLabel}
                class="text-primary hover:text-primary/70 transition-colors">
                <Icon name={icon.svg} class="w-5 h-5" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <!-- Blog Post List（与参考站一致：首页只保留文章列表与视图切换） -->
  <div class="flex items-center justify-between gap-2">
    <h2 class="text-lg font-bold text-base-content">最新文章</h2>
    <div class="join" role="group" aria-label="文章视图切换">
      <button
        type="button"
        class="btn btn-xs join-item btn-primary"
        data-post-view-btn="list"
        aria-label="列表视图"
        title="列表视图"
      >
        <Icon name="lucide:list" class="h-3.5 w-3.5" />
      </button>
      <button
        type="button"
        class="btn btn-xs join-item btn-ghost"
        data-post-view-btn="grid"
        aria-label="网格视图"
        title="网格视图"
      >
        <Icon name="lucide:layout-grid" class="h-3.5 w-3.5" />
      </button>
    </div>
  </div>
  <div id="post-list" class="post-list" data-post-view="list">
    {
      page.data.map((blog: Post) => (
        <PostCard
          title={blog.data.title}
          image={blog.data.image}
          description={blog.data.description}
          url={"/blog/" + blog.slug}
          pubDate={blog.data.pubDate}
          badge={blog.data.badge}
          categories={blog.data.categories}
          tags={blog.data.tags}
          word={blog.remarkPluginFrontmatter.totalCharCount}
          time={blog.remarkPluginFrontmatter.readingTime}
        />
      ))
    }
  </div>

  <script is:inline>
    (() => {
      const STORAGE_KEY = "ryuchan_post_view";
      const init = () => {
        const list = document.getElementById("post-list");
        if (!list) return;
        const buttons = Array.from(document.querySelectorAll("[data-post-view-btn]"));
        const apply = (view) => {
          list.dataset.postView = view;
          buttons.forEach((btn) => {
            const active = btn.dataset.postViewBtn === view;
            btn.classList.toggle("btn-primary", active);
            btn.classList.toggle("btn-ghost", !active);
          });
        };
        buttons.forEach((btn) => {
          btn.addEventListener("click", () => {
            const view = btn.dataset.postViewBtn === "grid" ? "grid" : "list";
            apply(view);
            try {
              localStorage.setItem(STORAGE_KEY, view);
            } catch {}
          });
        });
        let saved = "list";
        try {
          saved = localStorage.getItem(STORAGE_KEY) || "list";
        } catch {}
        apply(saved === "grid" ? "grid" : "list");
      };
      init();
      document.addEventListener("astro:page-load", init);
    })();
  </script>

  <Pagination page={page} totalPages={totalPages} pageLinks={pageLinks} baseUrl={``} />
</BaseLayout>
