---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CommentsSection from "@/components/comments/CommentsSection.astro";
import { Icon } from "astro-icon/components";
import { USER_AVATAR, USER_NAME } from "@config";
import { loadMoments } from "@/lib/load-moments";

const moments = loadMoments();

const formatDate = (iso: string) => {
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) return "";
  const pad = (value: number) => String(value).padStart(2, "0");
  return `${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}`;
};
---

<BaseLayout title="瞬间" isIndexed={true}>
  <!-- 页头 -->
  <div class="card-base p-5">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h1 class="flex items-center gap-2 text-2xl font-bold text-base-content md:text-3xl">
          <Icon name="material-symbols:bolt-outline-rounded" class="h-7 w-7 text-primary" />
          <span>瞬间</span>
          <span class="rounded-md bg-base-200/70 px-2 py-0.5 text-xs font-semibold text-base-content/60">
            {moments.length}
          </span>
        </h1>
        <p class="mt-1 text-sm text-base-content/60">记录日常的碎片、灵光与生活</p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <a href="/moments/rss.xml" class="btn btn-sm btn-ghost rounded-xl border bg-base-100/60 font-semibold">
          <Icon name="ri:rss-line" class="h-4 w-4" />
          RSS
        </a>
        <a href="/moments-edit/" class="btn btn-sm btn-primary rounded-xl px-4 font-semibold shadow-lg shadow-primary/20">
          <Icon name="lucide:pen-line" class="h-4 w-4" />
          编辑
        </a>
      </div>
    </div>
  </div>

  <!-- 瞬间列表 -->
  {
    moments.length > 0 ? (
      moments.map((moment) => (
        <article class="card-base p-5" id={`moment-${moment.id}`} data-moment-card>
          <div class="flex items-center gap-3">
            <img
              src={USER_AVATAR}
              alt={USER_NAME}
              class="h-10 w-10 rounded-full object-cover ring-2 ring-base-200"
              loading="lazy"
            />
            <div class="min-w-0">
              <div class="text-sm font-semibold text-base-content">{USER_NAME}</div>
              <div class="text-xs text-base-content/50">
                {formatDate(moment.date)}
                {moment.location ? ` · ${moment.location}` : ""}
              </div>
            </div>
            {moment.mood && (
              <span class="ml-auto inline-flex items-center rounded-full border border-primary/20 bg-primary/10 px-2 py-0.5 text-[11px] font-semibold text-primary">
                {moment.mood}
              </span>
            )}
          </div>

          <div class="mt-3 whitespace-pre-wrap text-sm leading-relaxed text-base-content/85">
            {moment.content}
          </div>

          {moment.images && moment.images.length > 0 && (
            <div
              class:list={[
                "mt-3 grid gap-2",
                moment.images.length === 1
                  ? "grid-cols-1"
                  : moment.images.length === 2
                    ? "grid-cols-2"
                    : "grid-cols-2 sm:grid-cols-3",
              ]}
            >
              {moment.images.map((src) => (
                <a
                  href={src}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block overflow-hidden rounded-xl bg-base-200/60"
                >
                  <img
                    src={src}
                    alt="瞬间配图"
                    class="h-full max-h-80 w-full object-cover transition-transform duration-300 hover:scale-105"
                    loading="lazy"
                  />
                </a>
              ))}
            </div>
          )}

          <div class="mt-4 flex items-center gap-4 border-t border-base-200 pt-3 text-xs text-base-content/50">
            <button
              type="button"
              data-moment-like={moment.id}
              class="inline-flex items-center gap-1 transition-colors hover:text-error"
              aria-label="点赞"
            >
              <Icon name="lucide:heart" class="h-4 w-4" />
              <span>赞</span>
            </button>
            <button
              type="button"
              data-moment-share
              data-moment-url={`/moments/#moment-${moment.id}`}
              class="inline-flex items-center gap-1 transition-colors hover:text-primary"
              aria-label="分享"
            >
              <Icon name="lucide:share-2" class="h-4 w-4" />
              <span>分享</span>
            </button>
            <a href="#comments" class="ml-auto inline-flex items-center gap-1 transition-colors hover:text-primary">
              <Icon name="lucide:message-circle" class="h-4 w-4" />
              <span>评论</span>
            </a>
          </div>
        </article>
      ))
    ) : (
      <div class="card-base p-10 text-center text-base-content/60">
        <p class="text-lg font-semibold">还没有瞬间</p>
        <p class="mt-1 text-sm">点击右上角「编辑」发布第一条瞬间吧。</p>
      </div>
    )
  }

  <!-- 评论 -->
  <CommentsSection />

  <script is:inline>
    (() => {
      const KEY = "ryuchan_moment_likes";
      const readLikes = () => {
        try {
          return new Set(JSON.parse(localStorage.getItem(KEY) || "[]"));
        } catch {
          return new Set();
        }
      };
      const init = () => {
        const likes = readLikes();
        document.querySelectorAll("[data-moment-like]").forEach((button) => {
          if (button.dataset.bound === "1") return;
          button.dataset.bound = "1";
          const id = button.dataset.momentLike;
          const label = button.querySelector("span");
          const update = () => {
            const liked = likes.has(id);
            button.classList.toggle("text-error", liked);
            if (label) label.textContent = liked ? "已赞" : "赞";
          };
          update();
          button.addEventListener("click", () => {
            if (likes.has(id)) likes.delete(id);
            else likes.add(id);
            try {
              localStorage.setItem(KEY, JSON.stringify([...likes]));
            } catch {}
            update();
          });
        });

        document.querySelectorAll("[data-moment-share]").forEach((button) => {
          if (button.dataset.bound === "1") return;
          button.dataset.bound = "1";
          button.addEventListener("click", async () => {
            const label = button.querySelector("span");
            const url = new URL(button.dataset.momentUrl || location.pathname, location.origin).toString();
            try {
              await navigator.clipboard.writeText(url);
              if (label) {
                const old = label.textContent;
                label.textContent = "已复制";
                setTimeout(() => (label.textContent = old), 1200);
              }
            } catch {}
          });
        });
      };
      init();
      document.addEventListener("astro:page-load", init);
    })();
  </script>
</BaseLayout>
