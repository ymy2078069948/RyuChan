---
import { Icon } from "astro-icon/components";
import { commentsConfig, umamiConfig } from "@config";

const { url, layout = "default" } = Astro.props as { url?: string; layout?: string };
const slug = url ? url.split("/").filter(Boolean).pop() : undefined;
const commentPath = slug ? `/blog/${slug}/` : undefined;
const twikooEnabled =
  commentsConfig?.enable &&
  commentsConfig.type === "twikoo" &&
  Boolean(commentsConfig.twikoo?.envId);
---

{
  slug && umamiConfig.enable && (
    <div class="flex items-center gap-x-3 gap-y-1 text-[10px] sm:text-sm text-base-content/70">
      <div class="flex items-center gap-1">
        <Icon name="lucide:eye" class="h-4 w-4 flex-shrink-0 text-primary" />
        <span class="truncate" id={`page-views-${slug}-${layout}`}>
          -
        </span>
      </div>
      <div class="flex items-center gap-1">
        <Icon name="lucide:user" class="h-4 w-4 flex-shrink-0 text-primary" />
        <span class="truncate" id={`page-visitors-${slug}-${layout}`}>
          -
        </span>
      </div>
      {twikooEnabled && commentPath && (
        <div class="flex items-center gap-1">
          <Icon name="lucide:message-circle" class="h-4 w-4 flex-shrink-0 text-primary" />
          <span class="truncate" data-comment-url={commentPath}>
            -
          </span>
        </div>
      )}
    </div>
  )
}
