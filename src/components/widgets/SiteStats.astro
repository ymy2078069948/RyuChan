---
import { Icon } from "astro-icon/components";
import { getSiteStats } from "@/lib/site-stats";
import dayjs from "@utils/dayjs";
import { DATE_FORMAT } from "@config";

const { postCount, categoryCount, tagCount, totalChars, lastUpdatedTs, runningDays } =
  await getSiteStats();
const lastUpdatedText = lastUpdatedTs ? dayjs(lastUpdatedTs).format(DATE_FORMAT) : "—";
const totalWordsText =
  totalChars >= 10_000 ? `${(totalChars / 10_000).toFixed(1)}w` : String(totalChars);
---

<div class="card-base p-4">
  <h3 class="mb-3 flex items-center gap-2 text-base font-bold text-base-content">
    <Icon name="material-symbols:bar-chart-rounded" class="h-4 w-4 text-primary" />
    <span>站点统计</span>
  </h3>

  <div class="grid grid-cols-3 gap-2 text-center">
    <div class="rounded-xl bg-base-200/50 px-1 py-2">
      <div class="text-[11px] text-base-content/55">文章</div>
      <div class="text-base font-bold text-primary">{postCount}</div>
    </div>
    <div class="rounded-xl bg-base-200/50 px-1 py-2">
      <div class="text-[11px] text-base-content/55">分类</div>
      <div class="text-base font-bold text-primary">{categoryCount}</div>
    </div>
    <div class="rounded-xl bg-base-200/50 px-1 py-2">
      <div class="text-[11px] text-base-content/55">标签</div>
      <div class="text-base font-bold text-primary">{tagCount}</div>
    </div>
  </div>

  <div class="mt-3 flex items-center justify-between text-xs text-base-content/55">
    <span>总字数</span>
    <span class="font-semibold text-base-content/80">{totalWordsText}</span>
  </div>
  <div class="mt-1 flex items-center justify-between text-xs text-base-content/55">
    <span>最后更新</span>
    <span class="font-semibold text-base-content/80">{lastUpdatedText}</span>
  </div>
  <div class="mt-1 flex items-center justify-between text-xs text-base-content/55">
    <span>运行天数</span>
    <span class="font-semibold text-base-content/80">{runningDays} 天</span>
  </div>
</div>
